+#[tokio::test]
+async fn bridge_silence_emits_one_cursor_error_terminal_and_cancels_request() {
+    use std::time::Duration;
+    let (_directory, store) = fixtures::temp_store().await;
+    let provider = fake_provider::FakeProvider::default().bridge(cursor_server::provider::BridgePolicy {
+        silence: Duration::from_millis(50), retry_budget: Duration::from_secs(2), retry_delay: Duration::from_millis(5),
+    });
+    provider.push_pending();
+    let registry = TransportRegistry::new(store, Arc::new(provider.clone()), PromptCompiler::new(PromptAssets::embedded().unwrap()));
+    let handle = registry.get_or_create("bridge-silence").await.unwrap();
+    let mut output = handle.subscribe();
+    handle.command(TransportCommand::Append { seqno: 0, message: Box::new(client_run()) }).await.unwrap();
+    let mut seqno = 1;
+    let mut terminals = 0;
+    let mut turn_ended = 0;
+    loop {
+        let Some(frame) = tokio::time::timeout(Duration::from_secs(2), output.recv()).await.unwrap() else { break };
+        let (flags, payload) = connect::decode_frames(&frame).unwrap().pop().unwrap();
+        if flags & connect::END_STREAM_FLAG != 0 {
+            terminals += 1;
+            let error: serde_json::Value = serde_json::from_slice(&payload).unwrap();
+            assert!(error.get("error").is_some());
+            continue;
+        }
+        let server = pb::AgentServerMessage::decode(payload).unwrap();
+        match server.message {
+            Some(pb::agent_server_message::Message::KvServerMessage(kv)) => {
+                handle.command(TransportCommand::Append { seqno, message: Box::new(kv_ack(kv.id)) }).await.unwrap();
+                seqno += 1;
+            }
+            Some(pb::agent_server_message::Message::InteractionUpdate(update)) => {
+                if matches!(update.message, Some(pb::interaction_update::Message::TurnEnded(_))) { turn_ended += 1; }
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(terminals, 1);
+    assert_eq!(turn_ended, 0);
+    assert_eq!(provider.requests().len(), 1);
+    assert!(provider.cancellations()[0].is_cancelled());
+}
