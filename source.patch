+//! Bridge 专用的语义静默边界；通用 Provider 不启用。
+use std::{io::Write, time::Duration};
+
+use async_stream::try_stream;
+use futures_util::StreamExt;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+use super::{ModelEvent, ProviderStream};
+use crate::Error;
+
+#[derive(Clone, Copy, Debug)]
+pub struct BridgePolicy {
+    pub silence: Duration,
+    pub retry_budget: Duration,
+    pub retry_delay: Duration,
+}
+
+impl Default for BridgePolicy {
+    fn default() -> Self {
+        Self {
+            silence: Duration::from_secs(60),
+            retry_budget: Duration::from_secs(120),
+            retry_delay: Duration::from_secs(5),
+        }
+    }
+}
+
+pub(crate) fn is_progress(event: &ModelEvent) -> bool {
+    match event {
+        ModelEvent::TextDelta(delta)
+        | ModelEvent::ThinkingDelta(delta)
+        | ModelEvent::ToolCallArgumentsDelta { delta, .. } => !delta.is_empty(),
+        _ => false,
+    }
+}
+
+pub(crate) fn transient_message(message: &str) -> bool {
+    let head = message.split_once(": ").map_or(message, |(head, _)| head);
+    matches!(
+        head,
+        "OpenAI Responses 502 Bad Gateway"
+            | "OpenAI Responses 503 Service Unavailable"
+            | "OpenAI Responses 504 Gateway Timeout"
+            | "OpenAI Chat 502 Bad Gateway"
+            | "OpenAI Chat 503 Service Unavailable"
+            | "OpenAI Chat 504 Gateway Timeout"
+    )
+}
+
+pub(crate) fn policy_event(
+    call_id: &str,
+    class: &'static str,
+    elapsed: Duration,
+    silence: Duration,
+) {
+    let attempt = call_id
+        .rsplit_once(":retry-")
+        .and_then(|(_, n)| n.parse::<u32>().ok())
+        .unwrap_or(0);
+    use sha2::{Digest, Sha256};
+    let logical_id = call_id.rsplit_once(":retry-").map_or(call_id, |(id, _)| id);
+    let safe_id = hex::encode(Sha256::digest(logical_id.as_bytes()));
+    let phase = match class {
+        "retry_scheduled" => "retry",
+        "silence" => "no_progress",
+        "retry_budget" => "retry_budget",
+        "cancelled" => "cancelled",
+        "done" => "completed",
+        _ => return,
+    };
+    let _ = writeln!(
+        std::io::stdout().lock(), "{}",
+        serde_json::json!({"event":"latency","call_id":safe_id,"attempt":attempt,"phase":phase,"elapsed_ms":elapsed.as_millis() as u64,"idle_ms":silence.as_millis() as u64})
+    );
+}
+
+#[cfg(test)]
+pub(crate) fn guarded_stream(
+    stream: ProviderStream,
+    cancellation: CancellationToken,
+    policy: BridgePolicy,
+    retry_deadline: Option<Instant>,
+) -> ProviderStream {
+    guarded_call(stream, cancellation, policy, retry_deadline, None)
+}
+
+pub(crate) fn guarded_call(
+    mut stream: ProviderStream,
+    cancellation: CancellationToken,
+    policy: BridgePolicy,
+    retry_deadline: Option<Instant>,
+    call_id: Option<String>,
+) -> ProviderStream {
+    Box::pin(try_stream! {
+        let cancel_on_drop = cancellation.clone().drop_guard();
+        let started = Instant::now();
+        let mut last_progress = started;
+        if let Some(id) = &call_id { policy_event(id, "started", Duration::ZERO, Duration::ZERO); }
+        let mut replay_safe = true;
+        loop {
+            let silence_deadline = last_progress + policy.silence;
+            let deadline = retry_deadline.map_or(silence_deadline, |end| end.min(silence_deadline));
+            let next = tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => {
+                    if let Some(id) = &call_id { policy_event(id, "cancelled", started.elapsed(), last_progress.elapsed()); }
+                    break;
+                },
+                _ = tokio::time::sleep_until(deadline) => {
+                    cancellation.cancel();
+                    let class = if retry_deadline.is_some_and(|end| end <= Instant::now()) {
+                        "retry_budget"
+                    } else { "silence" };
+                    if let Some(id) = &call_id { policy_event(id, class, started.elapsed(), last_progress.elapsed()); }
+                    tracing::warn!(class, silence_ms = last_progress.elapsed().as_millis() as u64, "bridge model deadline");
+                    Some(Err(Error::Provider(format!("bridge {class} deadline exceeded"))))
+                }
+                next = stream.next() => next,
+            };
+            let Some(next) = next else { break };
+            let event = match next {
+                Ok(event) => event,
+                Err(error) => {
+                    if cancellation.is_cancelled() { Err(Error::Provider(error.to_string()))?; }
+                    let transient = match &error {
+                        Error::Http(error) => error.is_connect(),
+                        Error::Provider(message) => transient_message(message),
+                        _ => false,
+                    };
+                    let class = if !replay_safe { "output_interrupted" }
+                        else if transient { "transient" } else { "terminal" };
+                    if let Some(id) = &call_id { policy_event(id, class, started.elapsed(), last_progress.elapsed()); }
+                    tracing::warn!(class, "bridge provider failure");
+                    let message = if replay_safe && transient { "bridge transient connection failure" }
+                        else if !replay_safe { "bridge provider interrupted after output; response was not replayed" }
+                        else { "bridge terminal provider failure" };
+                    Err(Error::Provider(message.into()))?
+                }
+            };
+            if is_progress(&event) {
+                last_progress = Instant::now();
+                replay_safe = false;
+            }
+            if matches!(event, ModelEvent::Done(_)) {
+                if let Some(id) = &call_id { policy_event(id, "done", started.elapsed(), last_progress.elapsed()); }
+            }
+            if matches!(event, ModelEvent::ToolCallStart { .. } | ModelEvent::Done(_)) {
+                replay_safe = false;
+            }
+            let done = matches!(event, ModelEvent::Done(_));
+            yield event;
+            if done { break; }
+        }
+        // 先释放 HTTP body 和 Recorder guard，再向消费方结束流。
+        drop(stream);
+        cancel_on_drop.disarm();
+    })
+}
