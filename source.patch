+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let (closed_tx, closed_rx) = tokio::sync::oneshot::channel();
+        let server = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut buffer = [0u8; 8192];
+            socket.read(&mut buffer).await.unwrap();
+            socket.write_all(b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\ndata: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[]}}\n\n").await.unwrap();
+            // 请求正文可能晚于首段请求头到达，读完剩余请求字节后再确认 EOF。
+            while socket.read(&mut buffer).await.unwrap_or(0) != 0 {}
+            let _ = closed_tx.send(());
+        });
+        let config = ProviderConfig {
+            kind: ProviderKind::OpenAiResponses,
+            request_url: format!("http://{address}"),
+            api_key: "test-only".into(),
+            custom_headers: reqwest::header::HeaderMap::new(),
+            max_output_tokens: None,
+            request_timeout: Duration::from_secs(2),
+            allowed_body_fields: None,
+        };
+        let provider = OpenAiResponsesProvider::new(reqwest::Client::new(), config);
+        let invocation = ModelInvocation {
+            call_id: "done".into(),
+            run_id: "done".into(),
+            conversation_id: "done".into(),
+            provider_call_index: 0,
+            request: ModelRequest {
+                prompt: PromptSpec {
+                    instructions: String::new(),
+                    tools: Vec::new(),
+                },
+                model: ModelSpec::new("route"),
+                history: Vec::new(),
+            },
+        };
+        let token = CancellationToken::new();
+        let mut stream = guarded_stream(
+            provider.stream(invocation, token.clone()),
+            token,
+            BridgePolicy::default(),
+            None,
+        );
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while let Some(event) = stream.next().await {
+                event.unwrap();
+            }
+        })
+        .await
+        .unwrap();
+        tokio::time::timeout(Duration::from_secs(1), closed_rx)
+            .await
+            .unwrap()
+            .unwrap();
+        server.await.unwrap();
+    }
