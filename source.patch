new file mode 100644
index 0000000..60c436b
--- /dev/null
+++ b/server/tests/bridge_policy.rs
@@ -0,0 +1,228 @@
+//! Bridge 引擎回归：短测试阈值，不真实等待生产策略的 60 秒。
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/fixtures.rs"]
+mod fixtures;
+
+use cursor_server::{
+    model::{ConversationId, ModelSpec, PreparedRun, PromptSpec, RunAction, RunId, RunKind},
+    provider::{BridgePolicy, FinishReason, ModelEvent},
+    run::{self, RunEngine, RunEvent, RunOutcome},
+    Error,
+};
+use std::{sync::Arc, time::Duration};
+
+fn policy() -> BridgePolicy {
+    BridgePolicy {
+        silence: Duration::from_millis(80),
+        retry_budget: Duration::from_secs(2),
+        retry_delay: Duration::from_millis(5),
+    }
+}
+
+async fn execute(provider: fake_provider::FakeProvider) -> (RunOutcome, Vec<RunEvent>) {
+    execute_with_cancel(provider, false).await
+}
+
+async fn execute_with_cancel(
+    provider: fake_provider::FakeProvider,
+    cancel_retry: bool,
+) -> (RunOutcome, Vec<RunEvent>) {
+    let (_directory, store) = fixtures::temp_store().await;
+    let conversation_id = ConversationId::new("bridge-test");
+    let checkpoint = store.ensure_conversation(&conversation_id).await.unwrap();
+    let prepared = PreparedRun {
+        run_id: RunId::new("bridge-test-run"),
+        cursor_request_id: None,
+        conversation_id,
+        kind: RunKind::Root,
+        model: ModelSpec::new("model"),
+        prompt: PromptSpec {
+            instructions: String::new(),
+            tools: Vec::new(),
+        },
+        initial_messages: Vec::new(),
+        action: RunAction::Resume {
+            pending_tool_round: None,
+        },
+        base_checkpoint_id: checkpoint,
+    };
+    let (port, mut session, handle) = run::channel(prepared.run_id.clone(), 64);
+    let cancellation = handle.cancellation();
+    let task = tokio::spawn(async move {
+        RunEngine::new(store, Arc::new(provider))
+            .run(prepared, port, cancellation)
+            .await
+    });
+    let mut events = Vec::new();
+    while let Some(mut event) = session.events.recv().await {
+        if let RunEvent::MessagesCommitted(committed) = &mut event {
+            std::mem::replace(&mut committed.barrier, run::CommitBarrier::None).complete(Ok(()));
+        }
+        if let RunEvent::ExecuteToolRound { calls, .. } = &event {
+            tokio::time::sleep(Duration::from_millis(120)).await;
+            for call in calls {
+                assert_eq!(handle.tool_result(cursor_server::model::ToolResult {
+                    call_id: call.call_id.clone(), content: "ok".into(),
+                    is_error: false, image: None,
+                }).await, run::CommandResult::Applied);
+            }
+        }
+        if cancel_retry && matches!(event, RunEvent::ModelAttemptFailed { .. }) {
+            handle.cancel();
+        }
+        let ended = matches!(event, RunEvent::Ended(_));
+        events.push(event);
+        if ended {
+            break;
+        }
+    }
+    (task.await.unwrap(), events)
+}
+
+fn success(provider: &fake_provider::FakeProvider) {
+    provider.push(vec![
+        ModelEvent::Start {
+            model_call_id: "success".into(),
+        },
+        ModelEvent::TextStart,
+        ModelEvent::TextDelta("ok".into()),
+        ModelEvent::TextEnd,
+        ModelEvent::Done(FinishReason::Stop),
+    ]);
+}
+
+#[tokio::test]
+async fn bridge_retries_transient_failure_once_and_completes() {
+    let provider = fake_provider::FakeProvider::default().bridge(policy());
+    provider.push_error(Error::Provider(
+        "OpenAI Responses 502 Bad Gateway: secret-body".into(),
+    ));
+    success(&provider);
+    let (outcome, events) = execute(provider.clone()).await;
+    assert_eq!(outcome, RunOutcome::Completed);
+    assert_eq!(provider.requests().len(), 2);
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, RunEvent::Ended(_)))
+            .count(),
+        1
+    );
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, RunEvent::ModelAttemptFailed { .. }))
+            .count(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn bridge_does_not_replay_partial_output_or_tool_id() {
+    for partial in [
+        ModelEvent::TextDelta("keep this".into()),
+        ModelEvent::ToolCallStart {
+            index: 0,
+            call_id: "tool".into(),
+            name: "Read".into(),
+        },
+    ] {
+        let provider = fake_provider::FakeProvider::default().bridge(policy());
+        provider.push_results(vec![
+            Ok(ModelEvent::Start {
+                model_call_id: "partial".into(),
+            }),
+            Ok(ModelEvent::TextStart),
+            Ok(partial),
+            Err(Error::Provider(
+                "OpenAI Responses 503 Service Unavailable: private-body".into(),
+            )),
+        ]);
+        let (outcome, _) = execute(provider.clone()).await;
+        assert!(matches!(outcome, RunOutcome::Failed(_)));
+        assert_eq!(provider.requests().len(), 1);
+    }
+}
+
+#[tokio::test]
+async fn bridge_silence_cancels_pending_provider_and_ends_once() {
+    let provider = fake_provider::FakeProvider::default().bridge(policy());
+    provider.push_pending();
+    let (outcome, events) = execute(provider.clone()).await;
+    assert!(matches!(outcome, RunOutcome::Failed(_)));
+    assert_eq!(provider.requests().len(), 1);
+    assert!(provider.cancellations()[0].is_cancelled());
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, RunEvent::Ended(_)))
+            .count(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn bridge_cancel_during_retry_delay_does_not_send_second_request() {
+    let provider = fake_provider::FakeProvider::default().bridge(BridgePolicy {
+        retry_delay: Duration::from_millis(200),
+        ..policy()
+    });
+    provider.push_error(Error::Provider(
+        "OpenAI Responses 503 Service Unavailable: private".into(),
+    ));
+    success(&provider);
