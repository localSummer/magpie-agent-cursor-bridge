new file mode 100644
index 0000000..9590ae9
--- /dev/null
+++ b/server/examples/magpie_smoke.rs
@@ -0,0 +1,48 @@
+//! Explicit live smoke test: args are proxy URL and catalogue model hash.
+use cursor_server::cursor::protocol::{connect,proto::{agent::v1 as pb,aiserver::v1 as ai}};
+use prost::Message;
+use futures_util::StreamExt;
+use std::time::Duration;
+async fn append(client:&reqwest::Client,id:&str,seq:i64,message:pb::AgentClientMessage) -> Result<(),Box<dyn std::error::Error>> {
+ let body=ai::BidiAppendRequest{data:hex::encode(message.encode_to_vec()),request_id:Some(ai::BidiRequestId{request_id:id.into()}),append_seqno:seq,..Default::default()};
+ let r=client.post("https://api2.cursor.sh/aiserver.v1.BidiService/BidiAppend").header("Content-Type","application/proto").body(body.encode_to_vec()).send().await?;
+ if !r.status().is_success(){return Err(format!("append {}: {}",r.status(),r.text().await?).into());} Ok(())
+}
+#[tokio::main]
+async fn main()->Result<(),Box<dyn std::error::Error>>{
+ let args:Vec<_>=std::env::args().collect();
+ let client=reqwest::Client::builder().proxy(reqwest::Proxy::all(&args[1])?).timeout(Duration::from_secs(120)).build()?;
+ let id=format!("bridge-smoke-{}",uuid::Uuid::new_v4());
+ let message=pb::AgentClientMessage{message:Some(pb::agent_client_message::Message::RunRequest(pb::AgentRunRequest{
+ action:Some(pb::ConversationAction{action:Some(pb::conversation_action::Action::UserMessageAction(pb::UserMessageAction{user_message:Some(pb::UserMessage{text:"Reply with exactly MAGPIE_BRIDGE_OK. Do not call any tools.".into(),message_id:format!("{id}-user"),mode:pb::AgentMode::Agent as i32,..Default::default()}),..Default::default()})),..Default::default()}),
+ conversation_id:Some(id.clone()),run_id:Some(id.clone()),requested_model:Some(pb::RequestedModel{model_id:args[2].clone(),..Default::default()}),..Default::default()}))};
+ append(&client,&id,0,message).await?;
+ let response=client.post("https://api2.cursor.sh/agent.v1.AgentService/RunSSE").header("Content-Type","application/proto").body(pb::BidiRequestId{request_id:id.clone()}.encode_to_vec()).send().await?.error_for_status()?;
+ let mut stream=response.bytes_stream();let mut buffer=Vec::new();let mut seq=1;let mut text=String::new();
+ while let Some(chunk)=stream.next().await {
+  buffer.extend_from_slice(&chunk?);
+  while buffer.len()>=5 {
+   let len=u32::from_be_bytes(buffer[1..5].try_into()?) as usize;
+   if buffer.len()<len+5 {break;}
+   let frame:Vec<_>=buffer.drain(..len+5).collect();
+   if frame[0]&connect::END_STREAM_FLAG!=0 {
+    let end:serde_json::Value=serde_json::from_slice(&frame[5..])?;
+    if end.get("error").is_some(){return Err(format!("stream error: {end}").into());}
+    if !text.contains("MAGPIE_BRIDGE_OK"){return Err(format!("unexpected response: {text}").into());}
+    println!("TLS proxy -> Cursor Bidi/RunSSE -> Magpie -> model -> Cursor stream: {text}");return Ok(());
+   }
+   let server=pb::AgentServerMessage::decode(&frame[5..])?;
+   let reply=match server.message {
+    Some(pb::agent_server_message::Message::InteractionUpdate(u))=>{if let Some(pb::interaction_update::Message::TextDelta(t))=u.message{text.push_str(&t.text);}None},
+    Some(pb::agent_server_message::Message::KvServerMessage(kv))=>Some(pb::AgentClientMessage{message:Some(pb::agent_client_message::Message::KvClientMessage(pb::KvClientMessage{id:kv.id,message:Some(pb::kv_client_message::Message::SetBlobResult(pb::SetBlobResult{error:None}))}))}),
+    Some(pb::agent_server_message::Message::ExecServerMessage(exec))=>{
+      if !matches!(exec.message,Some(pb::exec_server_message::Message::RequestContextArgs(_))){return Err("model requested an unexpected tool".into());}
+      append(&client,&id,seq,pb::AgentClientMessage{message:Some(pb::agent_client_message::Message::ExecClientControlMessage(pb::ExecClientControlMessage{message:Some(pb::exec_client_control_message::Message::StreamClose(pb::ExecClientStreamClose{id:exec.id}))}))}).await?;seq+=1;
+      Some(pb::AgentClientMessage{message:Some(pb::agent_client_message::Message::ExecClientMessage(pb::ExecClientMessage{id:exec.id,message:Some(pb::exec_client_message::Message::RequestContextResult(pb::RequestContextResult{result:Some(pb::request_context_result::Result::Success(pb::RequestContextSuccess{request_context:Some(pb::RequestContext::default()),..Default::default()}))})),..Default::default()}))})
+    },_=>None
+   };
+   if let Some(reply)=reply{append(&client,&id,seq,reply).await?;seq+=1;}
+  }
+ }
+ Err("stream closed before successful end".into())
+}
diff --git a/server/src/bin/cursor-magpie-bridge.rs b/server/src/bin/cursor-magpie-bridge.rs
new file mode 100644
index 0000000..80bb094
--- /dev/null
+++ b/server/src/bin/cursor-magpie-bridge.rs
@@ -0,0 +1,180 @@
+//! Headless Cursor protocol bridge. No desktop/account writes or management API.
+use std::{path::PathBuf, sync::Arc, time::Duration};
+use cursor_server::{api, config, cursor::{prompting::{PromptAssets, PromptCompiler}, transport::TransportRegistry}, local_app::CursorHarness, model::ModelConfigInput, network::NetworkClients, plugin::{PluginRegistry, PluginRuntime}, provider::ProviderRouter, search::WebCache, store::Store};
+use serde::Deserialize;
+use serde_json::json;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Deserialize)]
+struct Connection { gateway: String, key: String, model: String, models: Vec<BridgeModel> }
+#[derive(Deserialize)]
+struct BridgeModel { id: String, #[serde(default)] name: String, context: Option<u64>, #[serde(default, rename="reasoningLevels")] reasoning_levels: Option<Vec<String>> }
+
+async fn replace_catalogue(store: &Store, snapshot: &cursor_server::provider::BridgeCatalogue, bytes: &[u8]) -> Result<usize, Box<dyn std::error::Error>> {
+    let inputs = catalogue(bytes)?;
+    let connection: Connection = serde_json::from_slice(bytes)?;
+    let selected = connection.models.iter().find(|m| m.id == connection.model).ok_or("missing selected route")?;
+    let low = selected.reasoning_levels.as_ref().is_some_and(|levels| levels.iter().any(|level| level == "low"));
+    // 模型解析与目录提交在同一事务内完成；提交失败不发布能力。
+    let model = store.replace_bridge_catalogue(&inputs).await?.into_iter().next().ok_or("missing selected bridge model")?;
+    *snapshot.write().map_err(|_| "bridge catalogue lock poisoned")? = Some(cursor_server::provider::BridgeCommitModel { model, low });
+    Ok(inputs.len())
+}
+
+fn catalogue(bytes: &[u8]) -> Result<Vec<ModelConfigInput>, Box<dyn std::error::Error>> {
+    let c: Connection = serde_json::from_slice(bytes)?;
+    let url = url::Url::parse(&c.gateway)?;
+    if url.scheme() != "http" || !matches!(url.host_str(), Some("127.0.0.1" | "localhost" | "[::1]")) || !url.username().is_empty() || url.password().is_some() || url.query().is_some() || url.fragment().is_some() {
+        return Err("only a loopback Magpie gateway is supported".into());
+    }
+    if c.key.trim().is_empty() || !c.models.iter().any(|m| m.id == c.model) { return Err("missing gateway key or selected model".into()); }
+    let mut models = c.models;
+    models.sort_by_key(|m| m.id != c.model);
+    let mut seen = std::collections::HashSet::new();
+    models.into_iter().enumerate().map(|(i,m)| {
+        if !seen.insert(m.id.clone()) { return Err("duplicate model id".into()); }
+        Ok(serde_json::from_value(json!({
+            "sort_order": i, "display_name": if m.name.is_empty() {m.id.clone()} else {format!("{} · {}", m.name, m.id)},
+            "group_name":"Magpie", "type":"openai", "base_url": c.gateway.trim_end_matches('/'),
+            "api_key":c.key, "tooltip_data":format!("Magpie / {}",m.id), "model_id":m.id,
+            "context_window_tokens":m.context.filter(|v| *v > 0),
+            "custom_headers_enabled":true, "custom_headers":{"User-Agent":"cursor-magpie-bridge/0.2.3"}
+        }))?)
+    }).collect()
+}
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let argument = std::env::args().nth(1);
+    if argument.as_deref() == Some("--version") {
+        println!("0.2.3");
+        return Ok(());
+    }
+    if argument.as_deref() == Some("--help") || argument.is_none() {
+        println!("cursor-magpie-bridge 0.2.3\nUsage: cursor-magpie-bridge --init-ca | CONNECTION.json\nRequires CURSOR_BYOK_DATA_DIR (absolute path). --init-ca never modifies certificate trust.");
+        return Ok(());
+    }
+    // A dedicated directory is mandatory: never open the desktop BYOK database.
+    if std::env::var_os("CURSOR_BYOK_DATA_DIR").is_none() { return Err("CURSOR_BYOK_DATA_DIR is required".into()); }
+    if argument.as_deref() == Some("--init-ca") {
+        let state = cursor_server::local_app::initialize_bridge_ca()?;
+        println!("{}", json!({"ca":state, "certificate":config::managed_data_dir()?.join("ca/ca.crt")}));
+        return Ok(());
+    }
+    let path = PathBuf::from(argument.unwrap());
+    let mut contents = tokio::fs::read(&path).await?;
+    let inputs = catalogue(&contents)?;
+    let root = config::managed_data_dir()?;
+    let store = Store::connect(&format!("sqlite://{}",root.join("bridge.db").display())).await?;
+    let snapshot = Arc::new(std::sync::RwLock::new(None));
+    replace_catalogue(&store, &snapshot, &contents).await?;
+    let plugins = PluginRegistry::managed(store.clone(), PluginRuntime::managed()?, "1.0.1".into())?;
+    let clients = NetworkClients::new(store.clone());
+    let provider = Arc::new(ProviderRouter::new(store.clone(),plugins.clone(),clients.clone(),Duration::from_secs(3600),Duration::from_secs(1800)).with_bridge_catalogue(snapshot.clone()));
+    let registry = TransportRegistry::with_plugins(store.clone(),provider,PromptCompiler::new(PromptAssets::embedded()?),WebCache::managed()?,plugins,root.join("rules"));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    registry.web_cache().set_service_addr(address);
+    let router = api::router(registry.clone(),clients)?
+        .layer(axum::Extension(cursor_server::cursor::services::model_catalog::LocalCatalogOnly));
+    let harness = CursorHarness::new(store.clone())?;
+    harness.set_backend_addr(address);
+    let proxy = harness.start_proxy_only().await?;
+    let shutdown = CancellationToken::new();
+    let cancel = shutdown.clone();
+    let server = tokio::spawn(async move { axum::serve(listener,router).with_graceful_shutdown(async move {cancel.cancelled().await}).await });
+    println!("{}",json!({"event":"ready","proxy":proxy,"backend":format!("http://{address}"),"models":inputs.len()}));
+    // The supervisor owns stdin. Its death must not leave an orphan TLS proxy.
+    let parent_closed = CancellationToken::new();
+    let parent_signal = parent_closed.clone();
+    std::thread::spawn(move || {
+        use std::io::Read;
+        let mut buf = [0u8; 64];
+        while matches!(std::io::stdin().read(&mut buf), Ok(n) if n > 0) {}
+        parent_signal.cancel();
+    });
+    let mut interval = tokio::time::interval(Duration::from_secs(2));
+    let mut sigterm = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())?;
+    loop {
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => break,
+            _ = sigterm.recv() => break,
+            _ = parent_closed.cancelled() => break,
+            _ = interval.tick() => {
+                if server.is_finished() { break; }
+                match tokio::fs::read(&path).await {
+                    Ok(next) if next != contents => match catalogue(&next) {
+                        Ok(inputs) => {
+                            if replace_catalogue(&store, &snapshot, &next).await.is_ok() {
+                                contents = next;
+                                println!("{}",json!({"event":"catalogue","models":inputs.len()}));
+                            } else { eprintln!("catalogue update failed; retaining last complete catalogue"); }
+                        }
+                        Err(_) => eprintln!("invalid catalogue; retaining last complete catalogue"),
+                    },
+                    _ => {},
+                }
+            }
+        }
+    }
+    harness.stop_proxy_only().await;
+    registry.shutdown().await;
+    shutdown.cancel();
+    let _ = tokio::time::timeout(Duration::from_secs(10),server).await;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn config() -> serde_json::Value { json!({"gateway":"http://127.0.0.1:3425/v1","key":"test-only","model":"p/b","models":[{"id":"p/a","name":"A","context":200000},{"id":"p/b","name":"B"}]}) }
+    #[test]
+    fn selected_model_first_and_route_preserved() {
+        let models=catalogue(&serde_json::to_vec(&config()).unwrap()).unwrap();
+        assert_eq!(models[0].model_id,"p/b");
+        assert_eq!(models[1].context_window_tokens,Some(200000));
+        assert_eq!(models[0].base_url,"http://127.0.0.1:3425/v1");
+        assert_eq!(models[0].api_key,"test-only");
+    }
+    #[test]
+    fn rejects_remote_and_duplicate_models() {
+        let mut c=config();c["gateway"]=json!("http://evil.example/v1");assert!(catalogue(&serde_json::to_vec(&c).unwrap()).is_err());
+        let mut c=config();c["models"]=json!([{"id":"p/b"},{"id":"p/b"}]);assert!(catalogue(&serde_json::to_vec(&c).unwrap()).is_err());
+    }
+    #[tokio::test]
+    async fn capabilities_follow_exact_selected_route_and_failed_replacement_retains_snapshot() {
+        let dir=tempfile::tempdir().unwrap();
+        let store=Store::connect(&format!("sqlite://{}",dir.path().join("test.db").display())).await.unwrap();
+        let snapshot=Arc::new(std::sync::RwLock::new(None));
+        let mut c=config();
+        c["models"][0]["reasoningLevels"]=json!(["low"]);
+        replace_catalogue(&store,&snapshot,&serde_json::to_vec(&c).unwrap()).await.unwrap();
+        assert!(!snapshot.read().unwrap().as_ref().unwrap().low);
+        c["models"][1]["reasoningLevels"]=json!(["low","high"]);
+        replace_catalogue(&store,&snapshot,&serde_json::to_vec(&c).unwrap()).await.unwrap();
+        assert!(snapshot.read().unwrap().as_ref().unwrap().low);
+        c["models"][1]["reasoningLevels"]=json!(null);
+        replace_catalogue(&store,&snapshot,&serde_json::to_vec(&c).unwrap()).await.unwrap();
+        assert!(!snapshot.read().unwrap().as_ref().unwrap().low);
+        let hash=snapshot.read().unwrap().as_ref().unwrap().model.model_hash.clone();
+        c["key"]=json!("");
+        assert!(replace_catalogue(&store,&snapshot,&serde_json::to_vec(&c).unwrap()).await.is_err());
+        assert_eq!(snapshot.read().unwrap().as_ref().unwrap().model.model_hash,hash);
+        assert!(!snapshot.read().unwrap().as_ref().unwrap().low);
+    }
+    #[tokio::test]
+    async fn catalogue_update_is_atomic_and_retains_last_valid_models() {
+        let dir=tempfile::tempdir().unwrap();
+        let store=Store::connect(&format!("sqlite://{}",dir.path().join("test.db").display())).await.unwrap();
+        let inputs=catalogue(&serde_json::to_vec(&config()).unwrap()).unwrap();
+        store.replace_bridge_models(&inputs).await.unwrap();
+        let duplicate=vec![inputs[0].clone(),inputs[0].clone()];
+        assert!(store.replace_bridge_models(&duplicate).await.is_err());
+        assert_eq!(store.models().await.unwrap().len(),2);
+        let mut invalid=inputs.clone();invalid[1].api_key="".into();
+        assert!(store.replace_bridge_models(&invalid).await.is_err());
+        assert_eq!(store.models().await.unwrap().len(),2);
+        store.replace_bridge_models(&inputs[..1]).await.unwrap();
+        assert_eq!(store.models().await.unwrap().len(),1);
+    }
+}
